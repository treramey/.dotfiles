#!/usr/bin/env bash
# Omarchy dotfiles, linked from home/ using GNU Stow.
set -euo pipefail

readonly VERSION="4.0.0"
DOTFILES_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
readonly DOTFILES_DIR
readonly SOURCE_DIR="${DOTFILES_DIR}/home"
readonly LINK_PATH="${HOME}/.local/bin/dot"
readonly -a LIVE_PATHS=(".pi" ".agents" ".config/nvim")

require_stow() {
    command -v stow >/dev/null || {
        echo "GNU Stow is required. Install with: sudo pacman -S stow" >&2
        return 1
    }
}

sync_submodules() {
    # Initialize missing checkouts only. Never reset an existing live workspace.
    if [[ -f "${DOTFILES_DIR}/.gitmodules" && ! -e "${SOURCE_DIR}/.config/nvim/.git" ]]; then
        git -C "$DOTFILES_DIR" submodule update --init --recursive
    fi
}

run_stow() {
    # File links keep runtime files and generated palettes outside the source tree.
    stow --no-folding --dir="$DOTFILES_DIR" --target="$HOME" "$@" home
}

backup_target() {
    local rel="$1"
    mkdir -p "${BACKUP_DIR}/$(dirname "$rel")"
    mv -- "${HOME}/${rel}" "${BACKUP_DIR}/${rel}"
    printf 'Backed up %s to %s\n' "$rel" "$BACKUP_DIR"
}

link_live() {
    local rel target source
    for rel in "${LIVE_PATHS[@]}"; do
        target="${HOME}/${rel}"
        source="${SOURCE_DIR}/${rel}"
        [[ -d "$source" ]] || { echo "Missing workspace: $source" >&2; return 1; }
        if [[ -L "$target" && "$(readlink -f "$target")" == "$source" ]]; then
            continue
        fi
        if [[ -e "$target" || -L "$target" ]]; then
            [[ -n "${BACKUP_DIR:-}" ]] || {
                echo "Conflict: $target. Move it aside or use 'dot stow --backup'." >&2
                return 1
            }
            backup_target "$rel"
        fi
        mkdir -p "$(dirname "$target")"
        ln -s -- "$source" "$target"
    done
}

cmd_stow() {
    local backup=false simulate=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --backup) backup=true ;;
            -n|--simulate) simulate=true ;;
            *) echo "Usage: dot stow [--backup] [--simulate]" >&2; return 1 ;;
        esac
        shift
    done
    require_stow
    if $simulate; then
        run_stow --simulate --restow --verbose
        local rel
        for rel in "${LIVE_PATHS[@]}"; do
            printf 'Live link: %s -> %s\n' "${HOME}/${rel}" "${SOURCE_DIR}/${rel}"
            if [[ -e "${HOME}/${rel}" || -L "${HOME}/${rel}" ]]; then
                [[ -L "${HOME}/${rel}" && "$(readlink -f "${HOME}/${rel}")" == "${SOURCE_DIR}/${rel}" ]] || return 1
            fi
        done
        return
    fi
    sync_submodules
    BACKUP_DIR=""
    if $backup; then
        BACKUP_DIR="$(mktemp -d "${HOME}/.dotfiles-backup-XXXXXXXX")"
        # Stow owns ignore matching and conflict discovery. Never use --adopt,
        # which overwrites repository files with the deployed copies.
        local output rel
        if ! output="$(run_stow --simulate --restow 2>&1)"; then
            printf '%s\n' "$output" >&2
            local -a conflicts=()
            mapfile -t conflicts < <(printf '%s\n' "$output" | sed -n \
                -e 's/^  \* cannot stow .* over existing target \(.*\) since neither a link nor a directory and --adopt not specified$/\1/p' \
                -e 's/^  \* existing target is not owned by stow: \(.*\)$/\1/p')
            [[ ${#conflicts[@]} -gt 0 ]] || return 1
            for rel in "${conflicts[@]}"; do
                [[ "$rel" != /* && "$rel" != ".." && "$rel" != ../* && "$rel" != */../* ]] || return 1
                backup_target "$rel"
            done
        fi
    fi
    # Stow fails without modifying files if any unresolved conflicts remain.
    run_stow --restow --verbose
    link_live
    [[ -z "$BACKUP_DIR" ]] || echo "Migration backups: $BACKUP_DIR"
    echo "Dotfiles linked."
}

cmd_unstow() {
    [[ $# -eq 0 ]] || { echo "Usage: dot unstow" >&2; return 1; }
    require_stow
    run_stow --delete --verbose
    local rel target
    for rel in "${LIVE_PATHS[@]}"; do
        target="${HOME}/${rel}"
        if [[ -L "$target" && "$(readlink -f "$target")" == "${SOURCE_DIR}/${rel}" ]]; then
            rm -- "$target"
        fi
    done
}

cmd_link() {
    mkdir -p "$(dirname "$LINK_PATH")"
    if [[ -e "$LINK_PATH" || -L "$LINK_PATH" ]]; then
        [[ -L "$LINK_PATH" && "$(readlink -f "$LINK_PATH")" == "${DOTFILES_DIR}/dot" ]] && return 0
        echo "Refusing to replace $LINK_PATH" >&2
        return 1
    fi
    ln -s -- "${DOTFILES_DIR}/dot" "$LINK_PATH"
}

cmd_unlink() {
    if [[ -L "$LINK_PATH" && "$(readlink -f "$LINK_PATH")" == "${DOTFILES_DIR}/dot" ]]; then
        rm -- "$LINK_PATH"
    fi
}

cmd_init() {
    cmd_stow "$@"
    cmd_link
    if command -v bat >/dev/null; then bat cache --build; fi
}

cmd_update() {
    git -C "$DOTFILES_DIR" pull --ff-only
    cmd_stow "$@"
}

cmd_doctor() {
    require_stow
    local issues=0 rel
    run_stow --simulate --restow || issues=1
    for rel in ".config/fish/config.fish" ".config/mise/config.toml" "${LIVE_PATHS[@]}"; do
        if [[ "$(readlink -f "${HOME}/${rel}")" != "${SOURCE_DIR}/${rel}" || ! -e "${HOME}/${rel}" ]]; then
            echo "Missing or foreign link: ${HOME}/${rel}" >&2
            issues=1
        fi
    done
    git -C "$DOTFILES_DIR" submodule status
    return "$issues"
}

cmd_help() {
    cat <<EOF
dot v${VERSION}, Omarchy dotfiles managed with GNU Stow

Usage: dot COMMAND [OPTIONS]
  stow [--backup] [-n]   Refresh symlinks, default command
  restow                Alias for stow
  unstow                Remove owned symlinks, leave other files alone
  init [--backup]        Stow, link dot on PATH, build bat cache
  update                Pull with --ff-only and restow
  status                Preview link changes and conflicts without writing
  doctor                Check links and submodule state
  link / unlink         Install or remove dot at ~/.local/bin/dot
  edit                  Open the repository in \$EDITOR, default nvim
  help / --version      Show help or version

Existing files are never adopted or overwritten.
Use --backup to move conflicts into ~/.dotfiles-backup-* before linking.
Edit home/ directly. Linked file edits are live, no watcher is needed.
EOF
}

main() {
    local cmd="${1:-stow}"
    [[ $# -eq 0 ]] || shift
    case "$cmd" in
        stow|restow) cmd_stow "$@" ;;
        unstow) cmd_unstow "$@" ;;
        init) cmd_init "$@" ;;
        update) cmd_update "$@" ;;
        status) cmd_stow --simulate "$@" ;;
        doctor) cmd_doctor ;;
        link) cmd_link ;;
        unlink) cmd_unlink ;;
        edit) exec "${EDITOR:-nvim}" "$DOTFILES_DIR" ;;
        help|-h|--help) cmd_help ;;
        --version) echo "dot v${VERSION}" ;;
        *) echo "Unknown command: $cmd. Run 'dot help'." >&2; return 1 ;;
    esac
}
main "$@"
