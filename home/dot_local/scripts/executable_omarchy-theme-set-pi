#!/bin/bash
set -euo pipefail

# Sync Pi and Herdr from the active Omarchy palette.
# This backports Omarchy's generated `omarchy-system` theme approach without
# requiring newer Omarchy template mix helpers.

CURRENT_THEME_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/current/theme"
COLORS_PATH="$CURRENT_THEME_PATH/colors.toml"
PI_AGENT_DIR="$HOME/.pi/agent"
PI_THEME_DIR="$PI_AGENT_DIR/themes"
PI_THEME_PATH="$PI_THEME_DIR/omarchy-system.json"
PI_SETTINGS_PATH="$PI_AGENT_DIR/settings.json"
HERDR_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml"
PI_ACTIVATE=0

usage() {
  echo "Usage: omarchy-theme-set-pi [--activate]"
}

for arg in "$@"; do
  case "$arg" in
    --activate)
      PI_ACTIVATE=1
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

if [[ ! -f $COLORS_PATH ]]; then
  if (( PI_ACTIVATE == 1 )); then
    echo "Pi theme source missing: $COLORS_PATH" >&2
    exit 1
  fi

  exit 0
fi

if (( PI_ACTIVATE == 0 )) && [[ ! -d $PI_AGENT_DIR ]] && [[ ! -f $HERDR_CONFIG_PATH ]]; then
  exit 0
fi

if (( PI_ACTIVATE == 1 )) || [[ -d $PI_AGENT_DIR ]]; then
  mkdir -p "$PI_THEME_DIR"

  /usr/bin/python3 - "$COLORS_PATH" "$PI_THEME_PATH" <<'PY'
import json
import os
import sys
import tempfile
import tomllib

colors_path, theme_path = sys.argv[1], sys.argv[2]

with open(colors_path, "rb") as f:
    source = tomllib.load(f)


def hex_to_rgb(value):
    value = value.strip().lstrip("#")
    if len(value) != 6:
        raise ValueError(f"Expected 6-digit hex color, got {value!r}")
    return tuple(int(value[i : i + 2], 16) for i in (0, 2, 4))


def rgb_to_hex(rgb):
    return "#%02x%02x%02x" % tuple(max(0, min(255, int(round(channel)))) for channel in rgb)


def mix(start, end, amount):
    start_rgb = hex_to_rgb(start)
    end_rgb = hex_to_rgb(end)
    return rgb_to_hex(tuple(start_rgb[i] * (1 - amount) + end_rgb[i] * amount for i in range(3)))


required = [
    "background",
    "foreground",
    "accent",
    "selection_background",
    "selection_foreground",
    *[f"color{i}" for i in range(16)],
]
missing = [key for key in required if key not in source]
if missing:
    raise SystemExit(f"Missing required Omarchy colors: {', '.join(missing)}")

background = source["background"]
foreground = source["foreground"]
accent = source["accent"]

theme_vars = {
    "background": background,
    "foreground": foreground,
    "accent": accent,
    "selectionBackground": source["selection_background"],
    "selectionForeground": source["selection_foreground"],
    "selectedBackground": mix(background, accent, 0.22),
    "color0": source["color0"],
    "color1": source["color1"],
    "color2": source["color2"],
    "color3": source["color3"],
    "color4": source["color4"],
    "color5": source["color5"],
    "color6": source["color6"],
    "color7": source["color7"],
    "color8": source["color8"],
    "color9": source["color9"],
    "color10": source["color10"],
    "color11": source["color11"],
    "color12": source["color12"],
    "color13": source["color13"],
    "color14": source["color14"],
    "color15": source["color15"],
    "panel": mix(background, foreground, 0.06),
    "panelAlt": mix(background, foreground, 0.10),
    "panelPending": mix(background, accent, 0.12),
    "panelSuccess": mix(background, source["color2"], 0.12),
    "panelError": mix(background, source["color1"], 0.12),
    "border": mix(background, foreground, 0.30),
    "borderMuted": mix(background, foreground, 0.20),
    "mutedText": mix(foreground, background, 0.34),
    "dimText": mix(foreground, background, 0.52),
}

theme = {
    "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
    "name": "omarchy-system",
    "vars": theme_vars,
    "colors": {
        "accent": "accent",
        "border": "border",
        "borderAccent": "accent",
        "borderMuted": "borderMuted",
        "success": "color2",
        "error": "color1",
        "warning": "color3",
        "muted": "mutedText",
        "dim": "dimText",
        "text": "foreground",
        "thinkingText": "dimText",
        "selectedBg": "selectedBackground",
        "userMessageBg": "panel",
        "userMessageText": "foreground",
        "customMessageBg": "panel",
        "customMessageText": "foreground",
        "customMessageLabel": "accent",
        "toolPendingBg": "panelPending",
        "toolSuccessBg": "panelSuccess",
        "toolErrorBg": "panelError",
        "toolTitle": "accent",
        "toolOutput": "foreground",
        "mdHeading": "color5",
        "mdLink": "accent",
        "mdLinkUrl": "color6",
        "mdCode": "color6",
        "mdCodeBlock": "foreground",
        "mdCodeBlockBorder": "borderMuted",
        "mdQuote": "mutedText",
        "mdQuoteBorder": "borderMuted",
        "mdHr": "borderMuted",
        "mdListBullet": "color5",
        "toolDiffAdded": "color2",
        "toolDiffRemoved": "color1",
        "toolDiffContext": "mutedText",
        "syntaxComment": "dimText",
        "syntaxKeyword": "color5",
        "syntaxFunction": "color4",
        "syntaxVariable": "accent",
        "syntaxString": "color2",
        "syntaxNumber": "color3",
        "syntaxType": "color4",
        "syntaxOperator": "color5",
        "syntaxPunctuation": "mutedText",
        "thinkingOff": "borderMuted",
        "thinkingMinimal": "accent",
        "thinkingLow": "color4",
        "thinkingMedium": "color5",
        "thinkingHigh": "color3",
        "thinkingXhigh": "color1",
        "bashMode": "color3",
    },
    "export": {
        "pageBg": background,
        "cardBg": theme_vars["panel"],
        "infoBg": theme_vars["panelAlt"],
    },
}

os.makedirs(os.path.dirname(theme_path), exist_ok=True)
fd, tmp_path = tempfile.mkstemp(prefix=".omarchy-system.", suffix=".json", dir=os.path.dirname(theme_path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(theme, f, indent=2)
        f.write("\n")
    os.replace(tmp_path, theme_path)
finally:
    if os.path.exists(tmp_path):
        os.unlink(tmp_path)
PY
fi

if [[ -f $HERDR_CONFIG_PATH ]]; then
  /usr/bin/python3 - "$COLORS_PATH" "$HERDR_CONFIG_PATH" <<'PY'
import os
import re
import sys
import tempfile
import tomllib

colors_path, config_path = sys.argv[1:]
with open(colors_path, "rb") as f:
    colors = tomllib.load(f)

required = (
    "background", "foreground", "accent",
    "color1", "color2", "color3", "color4", "color5", "color6",
)
missing = [key for key in required if key not in colors]
if missing:
    raise SystemExit(f"Missing required Omarchy colors: {', '.join(missing)}")

with open(config_path, encoding="utf-8") as f:
    config = f.read()

theme_name = re.compile(r'(?ms)(^\[theme\]\n.*?^name\s*=\s*)[^\n]+')
if theme_name.search(config):
    config = theme_name.sub(r'\g<1>"terminal"', config, count=1)

def hex_to_rgb(value):
    value = value.strip().lstrip("#")
    if len(value) != 6:
        raise ValueError(f"Expected 6-digit hex color, got {value!r}")
    return tuple(int(value[i : i + 2], 16) for i in (0, 2, 4))


def mix(start, end, amount):
    start_rgb = hex_to_rgb(start)
    end_rgb = hex_to_rgb(end)
    result = tuple(round(start_rgb[i] * (1 - amount) + end_rgb[i] * amount) for i in range(3))
    return "#%02x%02x%02x" % result


background = colors["background"]
foreground = colors["foreground"]
muted_foreground = mix(foreground, background, 0.34)
custom = {
    # Let terminal opacity/background show through Herdr chrome (tab bar/sidebar).
    "panel_bg": "reset",
    "accent": colors["accent"],
    "surface0": mix(background, foreground, 0.06),
    "surface1": mix(background, foreground, 0.10),
    "surface_dim": mix(background, foreground, 0.03),
    # Herdr dims auto-named inactive tabs, so start them at full foreground.
    # This also keeps notification context text readable over transparency.
    "overlay0": foreground,
    "overlay1": muted_foreground,
    "text": foreground,
    "subtext0": muted_foreground,
    "mauve": colors["color5"],
    "blue": colors["color4"],
    "green": colors["color2"],
    "red": colors["color1"],
    "yellow": colors["color3"],
    "teal": colors["color6"],
    "peach": mix(colors["color1"], colors["color3"], 0.50),
}
custom_block = "[theme.custom]\n" + "".join(
    f'{key} = "{value}"\n' for key, value in custom.items()
)
section = re.compile(r"(?ms)^\[theme\.custom\]\n.*?(?=^\[|\Z)")
if section.search(config):
    config = section.sub(custom_block + "\n", config, count=1)
else:
    theme = re.search(r"(?m)^\[theme\]\s*$", config)
    if not theme:
        raise SystemExit("Herdr config has no [theme] section")
    config = config[: theme.end()] + "\n\n" + custom_block + config[theme.end():]

ui_accent = re.compile(r"(?ms)(^\[ui\]\n.*?^accent\s*=\s*)[^\n]+")
if ui_accent.search(config):
    config = ui_accent.sub(rf'\g<1>"{colors["accent"]}"', config, count=1)

fd, tmp_path = tempfile.mkstemp(prefix=".config.", suffix=".toml", dir=os.path.dirname(config_path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(config)
    os.replace(tmp_path, config_path)
finally:
    if os.path.exists(tmp_path):
        os.unlink(tmp_path)
PY

  if command -v herdr >/dev/null 2>&1; then
    herdr server reload-config >/dev/null 2>&1 || true
  fi
fi

if (( PI_ACTIVATE == 1 )); then
  mkdir -p "$PI_AGENT_DIR"

  if [[ -f $PI_SETTINGS_PATH ]]; then
    tmp=$(mktemp "$PI_SETTINGS_PATH.XXXXXX")
    jq '.theme = "omarchy-system"' "$PI_SETTINGS_PATH" >"$tmp"
    mv "$tmp" "$PI_SETTINGS_PATH"
  else
    cat >"$PI_SETTINGS_PATH" <<'EOF'
{
  "theme": "omarchy-system"
}
EOF
  fi
fi
