{{- if eq .chezmoi.os "windows" }}
# Managed by chezmoi. Keep this profile limited to Windows and portable tools.

# Let cross-platform command-line tools share a predictable per-user config
# location without applying this repository's Unix-specific .config tree.
$env:XDG_CONFIG_HOME = Join-Path $HOME ".config"
$env:STARSHIP_CONFIG = Join-Path $env:LOCALAPPDATA "starship.toml"
$env:MISE_GLOBAL_CONFIG_FILE = Join-Path $env:LOCALAPPDATA "mise\config.toml"

if (Get-Command nvim -ErrorAction SilentlyContinue) {
    $env:EDITOR = "nvim"
    $env:VISUAL = "nvim"
}

if (Get-Command mise -ErrorAction SilentlyContinue) {
    $miseActivation = & mise activate powershell
    Invoke-Expression ($miseActivation -join [Environment]::NewLine)
}

if (Get-Command starship -ErrorAction SilentlyContinue) {
    Invoke-Expression (& starship init powershell)
}
{{- end }}
