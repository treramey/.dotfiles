{
  "$schema": "zed://schemas/settings",

  "vim_mode": true,
  "vim": {
    "default_mode": "normal",
    "use_system_clipboard": "always",
    "use_smartcase_find": true,
    "use_regex_search": true,
    "cursor_shape": {
      "normal": "block",
      "replace": "underline",
      "visual": "block",
      "insert": "bar"
    }
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 400
  },

  // Omazed generates this theme from the active Omarchy palette.
  "theme": "Omazed",
  "buffer_font_family": "MonoLisa Variable",
  "buffer_font_size": 14,
  "relative_line_numbers": "enabled",
  "current_line_highlight": "all",
  "show_whitespaces": "none",
  "vertical_scroll_margin": 8,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "soft_wrap": "none",
  "preferred_line_length": 120,
  "show_wrap_guides": true,
  "wrap_guides": [120],

  "tab_size": 2,
  "hard_tabs": false,
  "use_smartcase_search": true,
  "format_on_save": "on",
  // Zed's auto formatter uses project Prettier configuration when available,
  // then falls back to the active language server.
  "formatter": "auto",
  "remove_trailing_whitespace_on_save": false,
  "autosave": "off",

  "hover_popover_enabled": false,
  "auto_signature_help": false,
  "inline_code_actions": false,
  "lsp_results_location": "picker",
  "diagnostics_max_severity": "warning",
  "inlay_hints": {
    "enabled": false
  },
  "edit_predictions": {
    "provider": "copilot",
    "mode": "eager"
  },

  "indent_guides": {
    "enabled": true,
    "coloring": "fixed"
  },
  "scrollbar": {
    "show": "never"
  },
  "minimap": {
    "show": "never"
  },
  "project_panel": {
    "dock": "left",
    "starts_open": false,
    "hide_gitignore": true,
    "hide_hidden": false,
    "git_status": true,
    "show_diagnostics": "all"
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "all",
    "activate_on_close": "history"
  },
  "preview_tabs": {
    "enabled": false
  },
  "git": {
    "enable_status": true,
    "enable_diff": true,
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": false
    },
    "path_style": "file_name_first"
  },
  "terminal": {
    "dock": "bottom",
    "starts_open": false,
    "working_directory": "current_file_directory",
    "font_family": "MonoLisa Variable",
    "cursor_shape": "block"
  },

  "auto_install_extensions": {
    "astro": true,
    "biome": true,
    "cfml": true,
    "csharp": true,
    "dockerfile": true,
    "emmylua": true,
    "less": true,
    "nginx": true,
    "nix": true,
    "oxc": true,
    "powershell": true,
    "svelte": true,
    "tombi": true,
    "toml": true,
    "xml": true
  },

  "file_types": {
    "XML": ["xaml"],
    "LESS": ["*.user.css"],
    "Nginx": ["*.conf"]
  },

  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "emmylua": {
      "settings": {
        "emmylua": {
          "diagnostics": {
            "disable": ["undefined-global"]
          },
          "runtime": {
            "version": "LuaJIT"
          }
        }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "astro": "html",
          "svelte": "html"
        }
      }
    }
  },

  "languages": {
    "Lua": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": [
            "--syntax=Lua54",
            "--respect-ignores",
            "--stdin-filepath",
            "{buffer_path}",
            "-"
          ]
        }
      }
    },
    "Go": {
      "format_on_save": "on",
      "formatter": "language_server",
      "hard_tabs": true
    },
    "Rust": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "Shell Script": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}", "--indent", "2"]
        }
      }
    },
    "XML": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "xmlformat",
          "arguments": ["--indent", "4", "--selfclose", "-"]
        }
      }
    },
    "Markdown": {
      "soft_wrap": "editor_width",
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "YAML": {
      "formatter": "prettier"
    },
    "SCSS": {
      "formatter": "prettier"
    },
    "CFML (Tag)": {
      "format_on_save": "off"
    },
    "CFML (Script)": {
      "format_on_save": "off"
    },
    "CFML (Query)": {
      "format_on_save": "off"
    }
  }
}
