# Herdr configuration
# Managed in ~/.dotfiles and applied to ~/.config/herdr/config.toml by chezmoi.
# Terminal-native workspace/tab/pane manager.

onboarding = false

[terminal]
# Use Fish while preserving login shell behavior.
default_shell = "fish"
shell_mode = "auto"
# New panes and tabs start in the current pane's directory.
new_cwd = "follow"

[theme]
{{ if .is_arch -}}
# Inherit the terminal palette so omarchy-theme-set-pi stays in control.
name = "terminal"
{{- else -}}
# Match Ghostty's `theme = light:Rose Pine Dawn,dark:Rose Pine`.
name = "rose-pine"
auto_switch = true
dark_name = "rose-pine"
light_name = "rose-pine-dawn"
{{- end }}

[theme.custom]
# Generated from the active Omarchy palette by omarchy-theme-set-pi.

[update]
channel = "stable"

[keys]
# Prefix: C-Space
prefix = "ctrl+space"

# Basics.
help = "prefix+?"
# Keep prefix+shift+s available for workspace picking.
settings = "prefix+shift+comma"
detach = ["prefix+d", "prefix+q"]
reload_config = "prefix+r"
goto = "prefix+s"

# Workspace controls:
#   prefix+shift+s choose workspace
#   prefix+w       also open workspace navigation (Herdr default muscle memory)
#   prefix+shift+w rename workspace (avoids symbol-layer gymnastics)
#   prefix+( / )   previous / next workspace
workspace_picker = ["prefix+shift+s", "prefix+w"]
new_workspace = "prefix+shift+n"
rename_workspace = "prefix+shift+w"
close_workspace = "prefix+shift+d"
previous_workspace = "prefix+("
next_workspace = "prefix+)"

# Agents.
focus_agent = "prefix+alt+1..9"

# Tab controls.
new_tab = "prefix+c"
previous_tab = "prefix+p"
next_tab = "prefix+n"
switch_tab = "prefix+1..9"
rename_tab = "prefix+comma"
close_tab = "prefix+shift+x"

# Pane creation (matching Omarchy/tmux muscle memory).
split_vertical = "prefix+v"
split_horizontal = "prefix+h"
close_pane = "prefix+x"
zoom = "prefix+m"
copy_mode = "prefix+y"

# Pane resize mode.
resize_mode = "prefix+shift+r"

# Pane navigation is handled by vim-herdr-navigation actions below.
cycle_pane_next = "prefix+tab"
cycle_pane_previous = "prefix+shift+tab"
# No last_pane binding: this layout runs one pane per tab, so it can never fire.
# tmux's prefix+l muscle memory lives in the herdr-last-tab command below.

# Keep Herdr's dashboard/sidebar available, but not on prefix+b since C-b is not the prefix here.
toggle_sidebar = "prefix+b"

# Navigate-mode movement.
navigate_workspace_up = "up"
navigate_workspace_down = "down"
navigate_pane_left = "h"
navigate_pane_down = "j"
navigate_pane_up = "k"
navigate_pane_right = "l"

# Forward ctrl+h/j/k/l into Neovim, or focus the adjacent Herdr pane.
[[keys.command]]
key = "ctrl+h"
type = "plugin_action"
command = "vim-herdr-navigation.left"
description = "navigate left (Vim/Herdr)"

[[keys.command]]
key = "ctrl+j"
type = "plugin_action"
command = "vim-herdr-navigation.down"
description = "navigate down (Vim/Herdr)"

[[keys.command]]
key = "ctrl+k"
type = "plugin_action"
command = "vim-herdr-navigation.up"
description = "navigate up (Vim/Herdr)"

[[keys.command]]
key = "ctrl+l"
type = "plugin_action"
command = "vim-herdr-navigation.right"
description = "navigate right (Vim/Herdr)"

# Browse repositories and their worktrees in one Television picker.
[[keys.command]]
key = "ctrl+f"
type = "pane"
command = "PATH=\"$HOME/.local/scripts:$PATH\" tv-wt"
description = "switch worktree"

[[keys.command]]
key = "prefix+g"
type = "pane"
command = "lazygit"
description = "open lazygit"

[[keys.command]]
key = "prefix+u"
type = "pane"
command = """cd "$HOME/workspace/work/Sv.Packages/master" && fish -lc 'pwsh -File ./GenerateInternalPackageVersions.ps1; echo; echo "Press Enter to close"; read -l answer'"""
description = "generate internal package versions"

# tmux's prefix+l (last-window). Herdr has no last-used-tab action, so this
# keeps its own history; type = "shell" runs it without a pane or popup.
[[keys.command]]
key = "prefix+l"
type = "shell"
command = "$HOME/.local/scripts/herdr-last-tab"
description = "last tab"

# Override Herdr's built-in "new worktree" key with the Worktrunk plugin's
# switch/create picker.
[[keys.command]]
key = "prefix+shift+g"
type = "plugin_action"
command = "worktrunk.open"
description = "Worktree: switch / create"

[[keys.command]]
# Avoid colliding with keys.close_workspace (prefix+shift+d).
key = "prefix+shift+backspace"
type = "plugin_action"
command = "worktrunk.remove"
description = "Worktree: remove"

[ui]
sidebar_width = 32
sidebar_min_width = 18
sidebar_max_width = 36
mouse_capture = true
right_click_passthrough_modifier = "ctrl"
mouse_scroll_lines = 3
# Close panes/tabs without prompting.
confirm_close = false
prompt_new_tab_name = false
# Rosé Pine iris.
accent = "#c4a7e7"
show_agent_labels_on_pane_borders = false
agent_panel_sort = "spaces"

[ui.toast]
delivery = "herdr"
delay_seconds = 1

[ui.toast.herdr]
position = "top-right"

[ui.toast.clipboard]
enabled = true
position = "bottom-center"

[ui.sound]
# Keep sound notifications disabled.
enabled = false

[session]
# Resume supported coding agents when restoring sessions.
resume_agents_on_restore = true

[remote]
manage_ssh_config = true

[experimental]
# Persist recent pane output to disk; keep in mind it may include secrets.
pane_history = true
allow_nested = false
kitty_graphics = true

[advanced]
# Scrollback limit is byte-based.
scrollback_limit_bytes = 52428800
