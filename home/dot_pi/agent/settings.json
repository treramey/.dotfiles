    "npm:@howaboua/pi-codex-imagegen",
    "npm:@howaboua/pi-codex-web-run",
    "npm:@howaboua/pi-gippity-control",
    "npm:@howaboua/pi-gpt-switcher",
    "npm:@howaboua/pi-memories",
    "npm:@howaboua/pi-pet",
