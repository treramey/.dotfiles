{
  "mcp": {
    "toolMode": "proxy",
    "startup": "lazy",
    "servers": {
      "executor": {
        "type": "remote",
        "url": "https://exe.mulroy.ai/mcp?elicitation_mode=native",
        "enabled": false
      },
      "cf-portal": {
        "type": "remote",
        "url": "https://portal.mcp.cfdata.org/mcp?codemode=search_and_execute",
        "oauth": {},
        "enabled": false
      },
      "uidotsh": {
        "type": "remote",
        "url": "https://ui.sh/mcp?agent=pi",
        "headers": {
          "Authorization": "Bearer ${UIDOTSH_TOKEN}"
        },
        "oauth": false,
        "enabled": false
      },
      "open-computer-use": {
        "type": "local",
        "command": ["/home/tmr/.pi/agent/bin/open-computer-use-system-python", "mcp"],
        "enabled": true,
        "timeout": 60000
      }
    }
  }
}
